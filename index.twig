{% extends 'layouts.master' %}

{% block content %}
  <section class="hero">
    <div class="container">
      <h1>{{ store.name }}</h1>
      <p>{{ store.description }}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">أقسامنا</span>
      <h2>ابدأ من القسم المناسب</h2>
      <div class="cat-grid">
        {% for category in categories %}
          <a href="{{ category.url }}" class="cat-card">
            {% if category.image %}
              <img src="{{ category.image }}" alt="{{ category.name }}" loading="lazy">
            {% endif %}
            <strong>{{ category.name }}</strong>
          </a>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>الأكثر طلباً</h2>
      <salla-products-list source="latest" limit="12"></salla-products-list>
    </div>
  </section>
{% endblock %}
